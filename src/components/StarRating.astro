---
import { formatRatingDisplay, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;
---

<div class="flex items-center">
    <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full whitespace-nowrap" data-testid="game-rating">
        {rating === null ? formatRatingDisplay(rating) : (
            <>
                <span class="text-yellow-400">{formatStarRating(rating)}</span>
                {formatRatingDisplay(rating)}
            </>
        )}
    </span>
</div>
