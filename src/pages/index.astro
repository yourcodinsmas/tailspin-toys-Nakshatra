---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
/** Categories available in the catalog, sorted for stable filter ordering. */
const categories = [...new Map(
  games.flatMap((game) => (game.category ? [[game.category.id, game.category] as const] : [])),
).values()].sort((left, right) => left.name.localeCompare(right.name));
/** Publishers available in the catalog, sorted for stable filter ordering. */
const publishers = [...new Map(
  games.flatMap((game) => (game.publisher ? [[game.publisher.id, game.publisher] as const] : [])),
).values()].sort((left, right) => left.name.localeCompare(right.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form
            class="mb-8 grid gap-6 rounded-xl border border-slate-700 bg-slate-800/60 p-6 sm:grid-cols-[1fr_auto]"
            data-testid="game-filters"
          >
            <fieldset>
              <legend class="mb-3 text-lg font-medium text-slate-100">Categories</legend>
              <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                  <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-700 px-3 py-2 text-slate-200 hover:bg-slate-700">
                    <input
                      class="rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      type="checkbox"
                      name="category"
                      value={category.id}
                      data-testid="category-filter"
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div class="flex flex-col items-start gap-4 sm:min-w-56">
              <label class="w-full text-sm font-medium text-slate-200" for="publisher-filter">
                Publisher
                <select
                  class="mt-2 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  id="publisher-filter"
                  name="publisher"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                  ))}
                </select>
              </label>
              <button
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                type="reset"
                data-testid="clear-filters"
              >
                Clear filters
              </button>
            </div>

            <p class="text-sm text-slate-300 sm:col-span-2" role="status" aria-live="polite" data-testid="filter-results">
              Showing {games.length} of {games.length} games
            </p>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <p class="mt-6 text-slate-300" data-testid="no-filter-results" hidden>
            No games match the selected filters.
          </p>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const resultStatus = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const noResultsMessage = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');

  if (filterForm && gamesGrid && resultStatus && noResultsMessage) {
    const gameCards = Array.from(
      gamesGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'),
    );

    /** Applies the selected category and publisher filters to the rendered cards. */
    const updateResults = (): void => {
      const selectedCategories = new Set(
        Array.from(
          filterForm.querySelectorAll<HTMLInputElement>(
            '[data-testid="category-filter"]:checked',
          ),
          (input) => input.value,
        ),
      );
      const selectedPublisher =
        filterForm.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]')?.value ?? '';
      let visibleGames = 0;

      for (const card of gameCards) {
        const matchesCategory =
          selectedCategories.size === 0 ||
          selectedCategories.has(card.dataset.gameCategoryId ?? '');
        const matchesPublisher =
          selectedPublisher === '' || card.dataset.gamePublisherId === selectedPublisher;
        const isVisible = matchesCategory && matchesPublisher;

        card.hidden = !isVisible;
        if (isVisible) {
          visibleGames += 1;
        }
      }

      resultStatus.textContent = `Showing ${visibleGames} of ${gameCards.length} games`;
      noResultsMessage.hidden = visibleGames > 0;
    };

    filterForm.addEventListener('change', updateResults);
    filterForm.addEventListener('reset', () => window.requestAnimationFrame(updateResults));
  }
</script>
